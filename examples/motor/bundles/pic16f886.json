 "source": [
  "//***************************************************************",
  "//\tmotor.c  DC モーターを H ブリッジ (IBT-2 / BTS7960) で動かす",
  "//\tPIC16F886  内部クロック 8MHz  XC8",
  "//***************************************************************",
  "#include <xc.h>",
  "#pragma config CONFIG1 = 0x20C4",
  "",
  "// 定数の宣言",
  "#define _XTAL_FREQ\t8000000\t\t//8MHz for __delay_ms()",
  "",
  "// IBT-2 モジュールとの接続",
  "//\tRC2 (CCP1) -> RPWM   正転の PWM",
  "//\tRC1 (CCP2) -> LPWM   逆転の PWM",
  "//\tRC0        -> R_EN と L_EN   1 で有効、0 で全オフ (惰性で停止)",
  "#define MOTOR_EN\tPORTCbits.RC0",
  "#define DUTY_MAX\t100\t\t\t// CCPRxL の値 (x4 = 400 / 400) = 100%",
  "",
  "//-----------------------------------------------------------",
  "//\tMain関数",
  "//-----------------------------------------------------------",
  "void main(void)",
  "{",
  "\t// PICの初期化",
  "\tOSCCON = 0b01110000;\t// 8MHzの内部クロックで動作",
  "\tANSEL  = 0b00000000;\t// アナログ入力 AN0からAN7 を無効",
  "\tANSELH = 0b00000000;\t// アナログ入力 AN8からAN13 を無効",
  "",
  "\t// 入出力の設定(0:出力 1:入力)",
  "\tTRISA = 0b11111111;\t\t// PORTAの入力設定",
  "\tTRISB = 0b11111111;\t\t// PORTBの入力設定",
  "\tTRISC = 0b11111000;\t\t// RC0, RC1, RC2 を出力",
  "\tPORTC = 0b00000000;\t\t// 出力の初期値 (EN = 0, PWM = 0)",
  "",
  "\t// PWM の設定  周波数 = 8MHz / (4 x 1 x 100) = 20kHz",
  "\tPR2     = 99;\t\t\t// 周期 = (99 + 1) x 4 x 1 / 8MHz = 50us",
  "\tT2CON   = 0b00000100;\t// Timer2 オン、プリスケール 1:1",
  "\tCCPR1L  = 0;\t\t\t// 正転の時間幅 0",
  "\tCCPR2L  = 0;\t\t\t// 逆転の時間幅 0",
  "\tCCP1CON = 0b00001100;\t// CCP1 を PWM モードに (下位2ビット DC1B = 00)",
  "\tCCP2CON = 0b00001100;\t// CCP2 を PWM モードに (下位2ビット DC2B = 00)",
  "",
  "\t// モーターの動作 (1秒ずつ)",
  "\tMOTOR_EN = 1;\t\t\t// ドライバ有効 (両方の PWM が 0 なのでブレーキ)",
  "\t__delay_ms(1000);",
  "\tCCPR1L = 30;\t\t\t// 正転 30% (30 x 4 = 120 / 400)",
  "\t__delay_ms(1000);",
  "\tCCPR1L = DUTY_MAX;\t\t// 正転 100%",
  "\t__delay_ms(1000);",
  "\tCCPR1L = 0;\t\t\t\t// ブレーキ (下側 2個がオン)",
  "\t__delay_ms(1000);",
  "\tCCPR2L = 50;\t\t\t// 逆転 50% (50 x 4 = 200 / 400)",
  "\t__delay_ms(1000);",
  "\tCCPR2L = 0;\t\t\t\t// ブレーキ",
  "\t__delay_ms(1000);",
  "\tMOTOR_EN = 0;\t\t\t// ドライバ無効 (全オフ、惰性で停止)",
  "",
  "\t// メインループ",
  "\twhile (1) {",
  "\t\t// ここにプログラムを記述",
  "\t}",
  "}"
 ]
}
