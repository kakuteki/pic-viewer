 "source": [
  "//***************************************************************",
  "//\tmotor.c  DC モーターを H ブリッジ (IBT-2 / BTS7960) で動かす",
  "//\tPIC16F1618  内部クロック 32MHz  XC8",
  "//***************************************************************",
  "#include <xc.h>",
  "#pragma config FOSC = INTOSC, WDTE = OFF, PWRTE = OFF, MCLRE = ON",
  "#pragma config CP = OFF, BOREN = ON, CLKOUTEN = OFF, LVP = OFF, PLLEN = OFF",
  "",
  "// 定数の宣言",
  "#define _XTAL_FREQ\t32000000\t//32MHz for __delay_ms()",
  "",
  "// IBT-2 モジュールとの接続",
  "//\tRC5 (CCP1) -> RPWM   正転の PWM",
  "//\tRC3 (CCP2) -> LPWM   逆転の PWM",
  "//\tRC4        -> R_EN と L_EN   1 で有効、0 で全オフ (惰性で停止)",
  "#define MOTOR_EN\tLATCbits.LATC4",
  "#define DUTY_MAX\t400\t\t\t// 4 x (PR2 + 1) = 100%",
  "",
  "//-----------------------------------------------------------",
  "//\tMain関数",
  "//-----------------------------------------------------------",
  "void main(void)",
  "{",
  "\t// PICの初期化",
  "\tOSCCON = 0b11110000;\t// 内部 8MHz x 4倍 PLL = 32MHz",
  "\tANSELA = 0b00000000;\t// PORTA のアナログ入力を無効",
  "\tANSELB = 0b00000000;\t// PORTB のアナログ入力を無効",
  "\tANSELC = 0b00000000;\t// PORTC のアナログ入力を無効",
  "",
  "\t// 入出力の設定(0:出力 1:入力)",
  "\tTRISA = 0b11111111;\t\t// PORTAの入力設定",
  "\tTRISB = 0b11111111;\t\t// PORTBの入力設定",
  "\tTRISC = 0b11000111;\t\t// RC3, RC4, RC5 を出力",
  "\tLATC  = 0b00000000;\t\t// 出力の初期値 (EN = 0, PWM = 0)",
  "",
  "\t// PWM の設定  周波数 = 32MHz / (4 x 4 x 100) = 20kHz",
  "\tT2CLKCON = 0b00000000;\t// Timer2 のクロックは Fosc/4",
  "\tPR2      = 99;\t\t\t// 周期 = (99 + 1) x 4 x 4 / 32MHz = 50us",
  "\tT2CON    = 0b10100000;\t// Timer2 オン、プリスケール 1:4",
  "\tCCPTMRS  = 0b00000000;\t// CCP1, CCP2 とも Timer2 を使う",
  "\tCCPR1    = 0;\t\t\t// 正転の時間幅 0",
  "\tCCPR2    = 0;\t\t\t// 逆転の時間幅 0",
  "\tCCP1CON  = 0b10001100;\t// CCP1 有効、PWM モード、右詰め",
  "\tCCP2CON  = 0b10001100;\t// CCP2 有効、PWM モード、右詰め",
  "\tRC5PPS   = 0b01100;\t\t// RC5 に CCP1 の出力を出す",
  "\tRC3PPS   = 0b01101;\t\t// RC3 に CCP2 の出力を出す",
  "",
  "\t// モーターの動作 (1秒ずつ)",
  "\tMOTOR_EN = 1;\t\t\t// ドライバ有効 (両方の PWM が 0 なのでブレーキ)",
  "\t__delay_ms(1000);",
  "\tCCPR1 = 120;\t\t\t// 正転 30% (120 / 400)",
  "\t__delay_ms(1000);",
  "\tCCPR1 = DUTY_MAX;\t\t// 正転 100%",
  "\t__delay_ms(1000);",
  "\tCCPR1 = 0;\t\t\t\t// ブレーキ (下側 2個がオン)",
  "\t__delay_ms(1000);",
  "\tCCPR2 = 200;\t\t\t// 逆転 50% (200 / 400)",
  "\t__delay_ms(1000);",
  "\tCCPR2 = 0;\t\t\t\t// ブレーキ",
  "\t__delay_ms(1000);",
  "\tMOTOR_EN = 0;\t\t\t// ドライバ無効 (全オフ、惰性で停止)",
  "",
  "\t// メインループ",
  "\twhile (1) {",
  "\t\t// ここにプログラムを記述",
  "\t}",
  "}"
 ]
}
